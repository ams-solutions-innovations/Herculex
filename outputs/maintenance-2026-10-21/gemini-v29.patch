+/** Validate image counts and bytes before consuming a quota unit. */
+export function validateRequestImages(payload: GeminiRequest): string | null {
+  const check = (images: GeminiImage[], limit: number) => {
+    const result = validateImages(images, limit);
+    return "error" in result ? result.error : null;
+  };
+  if (payload.kind === "physique_checkin") {
+    const baseline = payload.baselineImages;
+    const current = payload.currentImages;
+    if (!Array.isArray(baseline) || baseline.length < 1 || !Array.isArray(current) || current.length < 1) {
+      return "Baseline and current photos are required.";
+    }
+    for (const images of [baseline, current]) {
+      const error = check(images, 3);
+      if (error) return error;
+      const poses = images.map((p) => p.pose).filter((p) => p !== undefined);
+      if (poses.some((p) => !["front", "side", "back"].includes(p!)) || new Set(poses).size !== poses.length) {
+        return "Each photo needs a different front, side or back pose.";
+      }
+    }
+    return null;
+  }
+  if (payload.kind === "dream_physique") {
+    const current = payload.currentImages?.length ? payload.currentImages : payload.images ?? [];
+    const target = payload.targetImages?.length ? payload.targetImages : payload.targetImage ? [payload.targetImage] : [];
+    if (!Array.isArray(current) || !Array.isArray(target) || !current.length || !target.length || current.length + target.length > maxImages) {
+      return "Choose current and target photos (at most four in total).";
+    }
+    return check([...current, ...target], maxImages);
+  }
+  if (payload.kind === "body_fat_estimate") {
+    const images = payload.images ?? (payload.image ? [payload.image] : []);
+    if (!Array.isArray(images) || !images.length) return "An image is required.";
+    return check(images, maxImages);
+  }
+  if (payload.kind === "nutrition_label" || payload.kind === "barcode_product") {
+    const scan = validateScanImages(payload);
+    return "error" in scan ? scan.error : null;
+  }
+  if (["food_photo", "exercise_identification", "supplement_photo"].includes(payload.kind ?? "")) {
+    const result = validateImage(payload.image);
+    return "error" in result ? result.error : null;
+  }
+  return null;
+}
 

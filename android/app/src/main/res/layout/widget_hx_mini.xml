<?xml version="1.0" encoding="utf-8"?>
<!-- 4×1 Mini workout. The +1 Done target mirrors miniWorkout(): MINI_BUTTON
     (88 dp) wide, 40 dp tall, centred vertically, 14 dp from the end. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Light and dark renders of the same card. The alphas come from
         values/ and values-night/, so the launcher shows the one matching the
         phone's theme without the provider being told it changed. -->
    <ImageView
        android:id="@+id/widget_canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="@dimen/widget_hx_light_alpha"
        android:background="@drawable/widget_hx_placeholder"
        android:scaleType="fitXY" />

    <ImageView
        android:id="@+id/widget_canvas_dark"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="@dimen/widget_hx_dark_alpha"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <FrameLayout
        android:id="@+id/btn_primary"
        android:layout_width="88dp"
        android:layout_height="40dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="14dp"
        android:background="@drawable/widget_hx_pill_ripple"
        android:contentDescription="@string/widget_log_round" />

</FrameLayout>

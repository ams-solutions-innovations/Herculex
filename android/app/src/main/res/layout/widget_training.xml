<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_card_bg">

    <!-- Header: "TODAY" label + week badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/training_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TODAY"
            android:textSize="9sp"
            android:textColor="#98989F"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/training_week_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WEEK 1"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="#0A84FF"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/widget_week_badge_bg"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Headline (workout title) -->
    <TextView
        android:id="@+id/training_headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="No workout scheduled"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Stats line -->
    <TextView
        android:id="@+id/training_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textSize="11sp"
        android:textColor="#8E8E93"
        android:singleLine="true"
        android:ellipsize="end" />

    <!-- Start workout button -->
    <TextView
        android:id="@+id/btn_start_workout"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="12dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:gravity="center"
        android:text="Start workout"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/widget_start_workout_btn_bg" />

    <!-- Divider. FrameLayout, not View: RemoteViews only inflates @RemoteView
         classes and plain android.view.View is not one of them. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="8dp"
        android:background="#2C2C32" />

    <!-- Supplements header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SUPPLEMENTS"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="#9B59B6"
            android:letterSpacing="0.08"
            android:textAllCaps="true" />

        <TextView
            android:id="@+id/training_supp_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0/0"
            android:textSize="10sp"
            android:textColor="#8E8E93" />

    </LinearLayout>

    <!-- Supplement row 1 -->
    <LinearLayout
        android:id="@+id/training_supp_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <ImageView
            android:id="@+id/training_supp_dot_1"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="@drawable/widget_supplement_dot_outline"
            android:padding="3dp"
            android:src="@drawable/ic_widget_check" />

        <TextView
            android:id="@+id/training_supp_name_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text=""
            android:textSize="12sp"
            android:textColor="#F5F5F7"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/training_supp_dose_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text=""
            android:textSize="10sp"
            android:textColor="#8E8E93" />

        <TextView
            android:id="@+id/training_supp_time_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="9sp"
            android:textColor="#8E8E93"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/widget_time_badge_bg" />

    </LinearLayout>

    <!-- Supplement row 2 -->
    <LinearLayout
        android:id="@+id/training_supp_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <ImageView
            android:id="@+id/training_supp_dot_2"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="@drawable/widget_supplement_dot_outline"
            android:padding="3dp"
            android:src="@drawable/ic_widget_check" />

        <TextView
            android:id="@+id/training_supp_name_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text=""
            android:textSize="12sp"
            android:textColor="#F5F5F7"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/training_supp_dose_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text=""
            android:textSize="10sp"
            android:textColor="#8E8E93" />

        <TextView
            android:id="@+id/training_supp_time_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="9sp"
            android:textColor="#8E8E93"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/widget_time_badge_bg" />

    </LinearLayout>

    <!-- Supplement row 3 -->
    <LinearLayout
        android:id="@+id/training_supp_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <ImageView
            android:id="@+id/training_supp_dot_3"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="@drawable/widget_supplement_dot_outline"
            android:padding="3dp"
            android:src="@drawable/ic_widget_check" />

        <TextView
            android:id="@+id/training_supp_name_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text=""
            android:textSize="12sp"
            android:textColor="#F5F5F7"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/training_supp_dose_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text=""
            android:textSize="10sp"
            android:textColor="#8E8E93" />

        <TextView
            android:id="@+id/training_supp_time_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="9sp"
            android:textColor="#8E8E93"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/widget_time_badge_bg" />

    </LinearLayout>

    <!-- Supplement row 4 -->
    <LinearLayout
        android:id="@+id/training_supp_row_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <ImageView
            android:id="@+id/training_supp_dot_4"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="@drawable/widget_supplement_dot_outline"
            android:padding="3dp"
            android:src="@drawable/ic_widget_check" />

        <TextView
            android:id="@+id/training_supp_name_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text=""
            android:textSize="12sp"
            android:textColor="#F5F5F7"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/training_supp_dose_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text=""
            android:textSize="10sp"
            android:textColor="#8E8E93" />

        <TextView
            android:id="@+id/training_supp_time_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="9sp"
            android:textColor="#8E8E93"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/widget_time_badge_bg" />

    </LinearLayout>

</LinearLayout>

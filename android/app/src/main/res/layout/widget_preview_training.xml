<?xml version="1.0" encoding="utf-8"?>
<!-- Widget-picker preview for the Training card (4x3).
     Keep in sync with widget_training.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_card_bg">

    <!-- Header: "TODAY" label + week badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TODAY"
            android:textSize="9sp"
            android:textColor="@color/widget_text_secondary"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WEEK 3"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="@color/widget_badge_blue_text"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/widget_week_badge_bg" />

    </LinearLayout>

    <!-- Headline (workout title) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Push — Chest &amp; Triceps"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/widget_text_primary"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Stats line -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="6 exercises"
        android:textSize="11sp"
        android:textColor="@color/widget_text_secondary"
        android:singleLine="true"
        android:ellipsize="end" />

    <!-- Start workout button -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginTop="12dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:gravity="center"
        android:text="Start workout"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/widget_start_workout_btn_bg" />

    <!-- Divider -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="8dp"
        android:background="@color/widget_divider" />

    <!-- Supplements header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SUPPLEMENTS"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="@color/widget_macro_protein"
            android:letterSpacing="0.08"
            android:textAllCaps="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2/3"
            android:textSize="10sp"
            android:textColor="@color/widget_text_secondary" />

    </LinearLayout>

    <!-- Supplement row 1 (Taken) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="@drawable/widget_supplement_dot_filled"
            android:padding="3dp"
            android:src="@drawable/ic_widget_check"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Creatine Monohydrate"
            android:textSize="12sp"
            android:textColor="@color/widget_text_tertiary"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="5 g"
            android:textSize="10sp"
            android:textColor="@color/widget_text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="08:00"
            android:textSize="9sp"
            android:textColor="@color/widget_text_secondary"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/widget_time_badge_bg" />

    </LinearLayout>

    <!-- Supplement row 2 (Taken) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="@drawable/widget_supplement_dot_filled"
            android:padding="3dp"
            android:src="@drawable/ic_widget_check"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Whey Protein"
            android:textSize="12sp"
            android:textColor="@color/widget_text_tertiary"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="30 g"
            android:textSize="10sp"
            android:textColor="@color/widget_text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10:30"
            android:textSize="9sp"
            android:textColor="@color/widget_text_secondary"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/widget_time_badge_bg" />

    </LinearLayout>

    <!-- Supplement row 3 (Not taken) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="@drawable/widget_supplement_dot_outline"
            android:padding="3dp"
            android:src="@drawable/ic_widget_check"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Magnesium Bisglycinate"
            android:textSize="12sp"
            android:textColor="@color/widget_text_primary"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="400 mg"
            android:textSize="10sp"
            android:textColor="@color/widget_text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="21:00"
            android:textSize="9sp"
            android:textColor="@color/widget_text_secondary"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/widget_time_badge_bg" />

    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="@drawable/widget_card_bg">

    <!-- Left Section: Calorie Gauge Ring -->
    <FrameLayout
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center_vertical">

        <ImageView
            android:id="@+id/calories_ring_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="Calorie ring" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/calories_remaining_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textSize="19sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/calories_remaining_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Remaining"
                android:textSize="10sp"
                android:textColor="#8E8E93"
                android:includeFontPadding="false"
                android:layout_marginTop="1dp" />

        </LinearLayout>

    </FrameLayout>

    <!-- Middle Section: Breakdown Stats -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical">

        <!-- Base Goal -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_widget_flag"
                android:contentDescription="Base Goal" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Base Goal"
                    android:textSize="9sp"
                    android:textColor="#8E8E93"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/calories_base_goal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

            </LinearLayout>

        </LinearLayout>

        <!-- Food -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_widget_cutlery"
                android:contentDescription="Food" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Food"
                    android:textSize="9sp"
                    android:textColor="#8E8E93"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/calories_food_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

            </LinearLayout>

        </LinearLayout>

        <!-- Exercise -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_widget_flame"
                android:contentDescription="Exercise" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Exercise"
                    android:textSize="9sp"
                    android:textColor="#8E8E93"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/calories_exercise_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="13sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Vertical Divider -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#2C2C32"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:layout_marginEnd="10dp" />

    <!-- Right Section: Quick Action Buttons -->
    <LinearLayout
        android:layout_width="44dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Search Action Button -->
        <ImageView
            android:id="@+id/btn_search_food"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="9dp"
            android:background="@drawable/widget_action_btn_bg"
            android:src="@drawable/ic_widget_search"
            android:contentDescription="Search food"
            android:layout_marginBottom="8dp" />

        <!-- Barcode Scanner Action Button -->
        <ImageView
            android:id="@+id/btn_scan_food"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="9dp"
            android:background="@drawable/widget_action_btn_bg"
            android:src="@drawable/ic_widget_barcode"
            android:contentDescription="Scan food barcode" />

    </LinearLayout>

</LinearLayout>

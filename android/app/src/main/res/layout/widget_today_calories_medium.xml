<?xml version="1.0" encoding="utf-8"?>
<!-- Medium 4x2 Today's Calories widget: glassmorphic card with calorie ring,
     macro breakdown bars, and modern action buttons (Search, Scan, AI Photo). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="10dp"
    android:background="@drawable/widget_card_bg">

    <!-- Top: Calorie Gauge Ring + P/C/F Macro breakdown -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Calorie Gauge Ring -->
        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/calories_ring_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="Calorie ring" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/calories_remaining_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="20sp"
                    android:textColor="@color/widget_text_primary"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/calories_remaining_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KCAL LEFT"
                    android:textSize="8.5sp"
                    android:letterSpacing="0.06"
                    android:textColor="@color/widget_text_secondary"
                    android:includeFontPadding="false"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

        </FrameLayout>

        <!-- P/C/F progress rows -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:layout_marginStart="14dp">

            <!-- Protein row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/widget_dot"
                        android:backgroundTint="@color/widget_macro_protein" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="Protein"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_text_primary"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/macro_text_protein"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0/0"
                        android:textSize="10sp"
                        android:textColor="@color/widget_text_secondary"
                        android:includeFontPadding="false" />

                </LinearLayout>

                <ProgressBar
                    android:id="@+id/macro_progress_protein"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="3dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/widget_macro_protein"
                    android:progressBackgroundTint="@color/widget_divider" />

            </LinearLayout>

            <!-- Carbs row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/widget_dot"
                        android:backgroundTint="@color/widget_macro_carbs" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="Carbs"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_text_primary"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/macro_text_carbs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0/0"
                        android:textSize="10sp"
                        android:textColor="@color/widget_text_secondary"
                        android:includeFontPadding="false" />

                </LinearLayout>

                <ProgressBar
                    android:id="@+id/macro_progress_carbs"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="3dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/widget_macro_carbs"
                    android:progressBackgroundTint="@color/widget_divider" />

            </LinearLayout>

            <!-- Fat row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/widget_dot"
                        android:backgroundTint="@color/widget_macro_fat" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="Fat"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_text_primary"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/macro_text_fat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0/0"
                        android:textSize="10sp"
                        android:textColor="@color/widget_text_secondary"
                        android:includeFontPadding="false" />

                </LinearLayout>

                <ProgressBar
                    android:id="@+id/macro_progress_fat"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="3dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/widget_macro_fat"
                    android:progressBackgroundTint="@color/widget_divider" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Subtle divider -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/widget_divider"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <!-- Bottom: Modern tactile action pills (Search, Barcode Scan, AI Photo) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Search button -->
        <LinearLayout
            android:id="@+id/col_search_food"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="@drawable/widget_action_btn_bg"
            android:clickable="true">

            <ImageView
                android:id="@+id/btn_search_food"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_widget_search"
                android:contentDescription="Search food" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Search"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_primary"
                android:includeFontPadding="false" />

        </LinearLayout>

        <!-- Spacer -->
        <FrameLayout
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <!-- Barcode Scan button -->
        <LinearLayout
            android:id="@+id/col_scan_food"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="@drawable/widget_action_btn_bg"
            android:clickable="true">

            <ImageView
                android:id="@+id/btn_scan_food"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_widget_barcode"
                android:contentDescription="Scan food barcode" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Scan"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/widget_text_primary"
                android:includeFontPadding="false" />

        </LinearLayout>

        <!-- Spacer -->
        <FrameLayout
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <!-- AI Photo button (Highlighted Primary Pill) -->
        <LinearLayout
            android:id="@+id/col_camera_food"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1.1"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="@drawable/widget_action_btn_bg_highlight"
            android:clickable="true">

            <ImageView
                android:id="@+id/btn_camera_food"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_widget_camera_white"
                android:contentDescription="Log food from AI photo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="AI Photo"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:includeFontPadding="false" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>

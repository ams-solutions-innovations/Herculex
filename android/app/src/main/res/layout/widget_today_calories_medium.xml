<?xml version="1.0" encoding="utf-8"?>
<!-- Root is now vertical: a top row (ring + macro breakdown) over a bottom row
     of action buttons, instead of a 3-column layout with buttons stacked down
     the right edge. Matches the icon+label button style used in
     widget_quick_actions.xml for a consistent look across widgets. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="8dp"
    android:background="@drawable/widget_card_bg">

    <!-- Top: ring + macro breakdown. Takes all height left over after the
         button row below claims its wrap_content share. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Calorie Gauge Ring.
             Height is match_parent with a fixed width and a fitCenter image, so
             the ring grows into whatever height the host gives and scales down
             instead of clipping when the widget is resized short. -->
        <FrameLayout
            android:layout_width="108dp"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/calories_ring_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="Calorie ring" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/calories_remaining_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="19sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/calories_remaining_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Remaining"
                    android:textSize="10sp"
                    android:textColor="#94A3B8"
                    android:includeFontPadding="false"
                    android:layout_marginTop="1dp" />

            </LinearLayout>

        </FrameLayout>

        <!-- P/C/F progress rows. match_parent height with one weight each, so
             the three rows spread over the available height instead of
             clustering in the middle and leaving dead space. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <!-- Protein row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/widget_dot"
                    android:backgroundTint="#4DA3FF" />

                <ProgressBar
                    android:id="@+id/macro_progress_protein"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="#4DA3FF"
                    android:progressBackgroundTint="#2B374E" />

                <TextView
                    android:id="@+id/macro_text_protein"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/0"
                    android:textSize="10sp"
                    android:textColor="#94A3B8" />

            </LinearLayout>

            <!-- Carbs row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/widget_dot"
                    android:backgroundTint="#34C759" />

                <ProgressBar
                    android:id="@+id/macro_progress_carbs"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="#34C759"
                    android:progressBackgroundTint="#2B374E" />

                <TextView
                    android:id="@+id/macro_text_carbs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/0"
                    android:textSize="10sp"
                    android:textColor="#94A3B8" />

            </LinearLayout>

            <!-- Fat row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/widget_dot"
                    android:backgroundTint="#FFD60A" />

                <ProgressBar
                    android:id="@+id/macro_progress_fat"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="#FFD60A"
                    android:progressBackgroundTint="#2B374E" />

                <TextView
                    android:id="@+id/macro_text_fat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/0"
                    android:textSize="10sp"
                    android:textColor="#94A3B8" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Horizontal divider above the action row. FrameLayout, not View:
         RemoteViews only inflates @RemoteView classes and plain
         android.view.View is not one of them. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2B374E"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <!-- Bottom: action buttons row, each tap taking the user straight to what
         its icon shows (search → food search, scan → barcode viewfinder,
         photo → camera capture) instead of a generic "open Nutrition tab". -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Search -->
        <LinearLayout
        android:id="@+id/col_search_food"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/btn_search_food"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="8dp"
                android:background="@drawable/widget_action_btn_bg"
                android:src="@drawable/ic_widget_search"
                android:contentDescription="Search food" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Search"
                android:textSize="9sp"
                android:textColor="#94A3B8" />

        </LinearLayout>

        <!-- Divider. FrameLayout, not View: RemoteViews only inflates
             @RemoteView classes and plain android.view.View is not one of
             them. -->
        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="34dp"
            android:background="#2B374E" />

        <!-- Scan -->
        <LinearLayout
        android:id="@+id/col_scan_food"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/btn_scan_food"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="8dp"
                android:background="@drawable/widget_action_btn_bg"
                android:src="@drawable/ic_widget_barcode"
                android:contentDescription="Scan food barcode" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Scan"
                android:textSize="9sp"
                android:textColor="#94A3B8" />

        </LinearLayout>

        <!-- Divider. FrameLayout, not View: RemoteViews only inflates
             @RemoteView classes and plain android.view.View is not one of
             them. -->
        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="34dp"
            android:background="#2B374E" />

        <!-- Photo (highlighted, per mockup) -->
        <LinearLayout
        android:id="@+id/col_camera_food"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/btn_camera_food"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="8dp"
                android:background="@drawable/widget_action_btn_bg_highlight"
                android:src="@drawable/ic_widget_camera"
                android:contentDescription="Log food from photo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Photo"
                android:textSize="9sp"
                android:textColor="#94A3B8" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>

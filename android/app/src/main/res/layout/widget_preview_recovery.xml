<?xml version="1.0" encoding="utf-8"?>
<!-- Widget-picker preview for the Recovery Score pill. Mirrors
     widget_pill_recovery, but keeps only the green progress bar: the runtime
     layout stacks three pre-tinted bars and toggles visibility, which a static
     preview does not need. Keep in sync with widget_pill_recovery.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:padding="10dp"
    android:background="@drawable/widget_pill_bg_dark">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💪"
        android:textSize="16sp"
        android:paddingEnd="6dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RECOVERY"
            android:textSize="9sp"
            android:textColor="#98989F"
            android:letterSpacing="0.08"
            android:textAllCaps="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="78%"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="6dp">

        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="100"
            android:progress="78"
            android:progressTint="#30D158"
            android:progressBackgroundTint="#3A383A" />

    </FrameLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Generic macro pill widget layout — reused for Net Carbs, Fat, and Protein.
     Color accent is set programmatically in each WidgetProvider. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:padding="10dp"
    android:background="@drawable/widget_pill_bg_dark">

    <!-- Colored accent dot set programmatically -->
    <View
        android:id="@+id/macro_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/widget_dot"
        android:layout_marginEnd="8dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/macro_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MACRO"
            android:textSize="9sp"
            android:textColor="#98989F"
            android:letterSpacing="0.08"
            android:textAllCaps="true" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <TextView
                android:id="@+id/macro_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0g"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/macro_target"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="/—"
                android:textSize="10sp"
                android:textColor="#98989F"
                android:layout_marginStart="2dp"
                android:layout_marginBottom="1dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Mini ring progress (circular) shown when widget is wider -->
    <ProgressBar
        android:id="@+id/macro_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="36dp"
        android:layout_height="6dp"
        android:max="100"
        android:progress="0"
        android:progressBackgroundTint="#3A383A" />

</LinearLayout>

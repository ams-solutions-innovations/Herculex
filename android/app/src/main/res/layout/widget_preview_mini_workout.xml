<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="center"
        android:background="@drawable/widget_hx_placeholder"
        android:paddingHorizontal="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/widget_preview_circle_variant">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_hx_check"
                    android:tint="@color/widget_hx_primary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Push-ups"
                    android:textColor="@color/widget_hx_on_surface"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="7dp"
                        android:layout_height="4dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_preview_primary_pill" />

                    <ImageView
                        android:layout_width="7dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="2dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_preview_primary_pill" />

                    <ImageView
                        android:layout_width="7dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="2dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_preview_primary_pill" />

                    <ImageView
                        android:layout_width="7dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="2dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_preview_progress_track" />

                    <ImageView
                        android:layout_width="7dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="2dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_preview_progress_track" />

                    <ImageView
                        android:layout_width="7dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="2dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_preview_progress_track" />

                    <ImageView
                        android:layout_width="7dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="2dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_preview_progress_track" />

                    <ImageView
                        android:layout_width="7dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="2dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_preview_progress_track" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="3 of 8 rounds"
                        android:textColor="@color/widget_hx_secondary"
                        android:textSize="9.5sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="74dp"
                android:layout_height="34dp"
                android:background="@drawable/widget_preview_primary_pill"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="+1 Done"
                    android:textColor="@color/widget_hx_on_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="center"
        android:background="@drawable/widget_hx_placeholder"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_preview_circle_variant">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_hx_check"
                    android:tint="@color/widget_hx_primary" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Push-ups"
                    android:textColor="@color/widget_hx_on_surface"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="12dp"
                        android:layout_height="5dp"
                        android:background="@drawable/widget_preview_primary_pill" />

                    <View
                        android:layout_width="12dp"
                        android:layout_height="5dp"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/widget_preview_primary_pill" />

                    <View
                        android:layout_width="12dp"
                        android:layout_height="5dp"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/widget_preview_primary_pill" />

                    <View
                        android:layout_width="12dp"
                        android:layout_height="5dp"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/widget_preview_progress_track" />

                    <View
                        android:layout_width="12dp"
                        android:layout_height="5dp"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/widget_preview_progress_track" />

                    <View
                        android:layout_width="12dp"
                        android:layout_height="5dp"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/widget_preview_progress_track" />

                    <View
                        android:layout_width="12dp"
                        android:layout_height="5dp"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/widget_preview_progress_track" />

                    <View
                        android:layout_width="12dp"
                        android:layout_height="5dp"
                        android:layout_marginStart="3dp"
                        android:background="@drawable/widget_preview_progress_track" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:text="3 of 8 rounds"
                        android:textColor="@color/widget_hx_secondary"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="88dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_preview_primary_pill"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+1 Done"
                    android:textColor="@color/widget_hx_on_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</FrameLayout>

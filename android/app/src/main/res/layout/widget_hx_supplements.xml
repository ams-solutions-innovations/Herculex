<?xml version="1.0" encoding="utf-8"?>
<!-- 4×2 Supplements. The checklist targets mirror HxWidgetRenderer.supplements():
     16 dp padding, the grid starting 74 dp down (16 + 32 header + 10 + 6 bar +
     10), two equal columns 14 dp apart, 28 dp rows (20 dp item + 8 dp gap). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Light and dark renders of the same card. The alphas come from
         values/ and values-night/, so the launcher shows the one matching the
         phone's theme without the provider being told it changed. -->
    <ImageView
        android:id="@+id/widget_canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="@dimen/widget_hx_light_alpha"
        android:background="@drawable/widget_hx_placeholder"
        android:scaleType="fitXY" />

    <ImageView
        android:id="@+id/widget_canvas_dark"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="@dimen/widget_hx_dark_alpha"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="74dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:orientation="horizontal">
            <FrameLayout
                android:id="@+id/btn_item_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_hx_pill_ripple" />
            <View
                android:layout_width="14dp"
                android:layout_height="match_parent" />
            <FrameLayout
                android:id="@+id/btn_item_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_hx_pill_ripple" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:orientation="horizontal">
            <FrameLayout
                android:id="@+id/btn_item_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_hx_pill_ripple" />
            <View
                android:layout_width="14dp"
                android:layout_height="match_parent" />
            <FrameLayout
                android:id="@+id/btn_item_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_hx_pill_ripple" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:orientation="horizontal">
            <FrameLayout
                android:id="@+id/btn_item_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_hx_pill_ripple" />
            <View
                android:layout_width="14dp"
                android:layout_height="match_parent" />
            <FrameLayout
                android:id="@+id/btn_item_5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_hx_pill_ripple" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Widget-picker preview for the Protein pill. Mirrors widget_pill_protein
     with sample values baked in; ids are omitted because nothing addresses
     this layout at runtime. Keep in sync with widget_pill_protein.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:padding="10dp"
    android:background="@drawable/widget_pill_bg_dark">

    <ImageView
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/widget_dot"
        android:backgroundTint="#4DA3FF"
        android:layout_marginEnd="8dp"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PROTEIN"
            android:textSize="9sp"
            android:textColor="#94A3B8"
            android:letterSpacing="0.08"
            android:textAllCaps="true" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="142g"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="/180g"
                android:textSize="10sp"
                android:textColor="#94A3B8"
                android:layout_marginStart="2dp"
                android:layout_marginBottom="1dp" />

        </LinearLayout>

    </LinearLayout>

    <ProgressBar
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="36dp"
        android:layout_height="6dp"
        android:max="100"
        android:progress="79"
        android:progressTint="#4DA3FF"
        android:progressBackgroundTint="#2B374E" />

</LinearLayout>

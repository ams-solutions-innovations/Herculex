<?xml version="1.0" encoding="utf-8"?>
<!-- Recovery Score pill widget layout (2x1) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:background="@drawable/widget_pill_bg_dark">

    <ImageView
        android:id="@+id/recovery_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_widget_bolt"
        android:contentDescription="Recovery" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/recovery_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RECOVERY"
            android:textSize="9sp"
            android:textColor="@color/widget_text_secondary"
            android:letterSpacing="0.08"
            android:textAllCaps="true" />

        <TextView
            android:id="@+id/recovery_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="16sp"
            android:textColor="@color/widget_text_primary"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Progress bars (only one visible at a time) -->
    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="5dp">
        <ProgressBar
            android:id="@+id/recovery_progress_green"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/widget_badge_green_text"
            android:progressBackgroundTint="@color/widget_divider"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/recovery_progress_amber"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/widget_badge_amber_text"
            android:progressBackgroundTint="@color/widget_divider"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/recovery_progress_red"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/widget_badge_red_text"
            android:progressBackgroundTint="@color/widget_divider"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>

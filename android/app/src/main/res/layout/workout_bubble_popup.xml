<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubble_popup_root"
    android:layout_width="@dimen/workout_bubble_popup_width"
    android:layout_height="wrap_content"
    android:background="@drawable/bubble_popup_background"
    android:elevation="16dp"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- ── 1. Top Stats Bar (Time, Sets, Volume) ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bubble_card_background"
        android:orientation="horizontal"
        android:paddingVertical="8dp"
        android:paddingHorizontal="6dp">

        <!-- TIME -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TIME"
                android:textColor="@color/bubble_on_surface_variant"
                android:textSize="10sp"
                android:textStyle="bold" />
            <Chronometer
                android:id="@+id/bubble_popup_elapsed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/bubble_accent"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:background="#26FFFFFF" />

        <!-- SETS -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SETS"
                android:textColor="@color/bubble_on_surface_variant"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/bubble_popup_stats_sets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="0"
                android:textColor="@color/bubble_on_surface"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:background="#26FFFFFF" />

        <!-- VOLUME -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VOLUME"
                android:textColor="@color/bubble_on_surface_variant"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/bubble_popup_stats_volume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="0 kg"
                android:textColor="@color/bubble_on_surface"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── 2. Exercise Card ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bubble_card_background"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/bubble_popup_exercise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Barbell Back Squat"
            android:textColor="@color/bubble_on_surface"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bubble_popup_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Quads · Barbell"
            android:textColor="@color/bubble_on_surface_variant"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/bubble_popup_last_perf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/bubble_accent"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Set Table Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">
            <TextView
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="SET"
                android:textColor="@color/bubble_on_surface_variant"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="KG"
                android:textColor="@color/bubble_on_surface_variant"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="REPS"
                android:textColor="@color/bubble_on_surface_variant"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="RPE"
                android:textColor="@color/bubble_on_surface_variant"
                android:textSize="10sp"
                android:textStyle="bold" />
            <View
                android:layout_width="36dp"
                android:layout_height="1dp" />
        </LinearLayout>

        <!-- Set Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bubble_popup_set_num"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/bubble_on_surface"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- KG Box -->
            <TextView
                android:id="@+id/bubble_popup_weight"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:background="@drawable/bubble_pill_background"
                android:gravity="center"
                android:text="60"
                android:textColor="@color/bubble_on_surface"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <!-- REPS Box -->
            <TextView
                android:id="@+id/bubble_popup_reps"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:background="@drawable/bubble_pill_background"
                android:gravity="center"
                android:text="5"
                android:textColor="@color/bubble_on_surface"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <!-- RPE Box -->
            <TextView
                android:id="@+id/bubble_popup_rpe"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:background="@drawable/bubble_pill_background"
                android:gravity="center"
                android:text="RPE"
                android:textColor="@color/bubble_on_surface_variant"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Done / Complete Checkmark Button -->
            <FrameLayout
                android:id="@+id/bubble_popup_done_btn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bubble_check_background"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/bubble_popup_done_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_check" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ── 3. Bottom Float Bar (+ Exercise, ✓ Finish) ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <!-- + Exercise Button -->
        <TextView
            android:id="@+id/bubble_popup_btn_exercise"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bubble_secondary_btn_background"
            android:gravity="center"
            android:text="+ Exercise"
            android:textColor="@color/bubble_on_surface"
            android:textSize="14sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <!-- ✓ Finish Button -->
        <TextView
            android:id="@+id/bubble_popup_btn_finish"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bubble_primary_background"
            android:gravity="center"
            android:text="✓ Finish"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Fat pill widget layout (2x1) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:background="@drawable/widget_pill_bg_dark">

    <!-- Colored accent dot -->
    <ImageView
        android:id="@+id/macro_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/widget_dot"
        android:backgroundTint="@color/widget_macro_fat"
        android:layout_marginEnd="8dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/macro_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FAT"
            android:textSize="9sp"
            android:textColor="@color/widget_text_secondary"
            android:letterSpacing="0.08"
            android:textAllCaps="true" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">

            <TextView
                android:id="@+id/macro_current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0g"
                android:textSize="16sp"
                android:textColor="@color/widget_text_primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/macro_target"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="/—"
                android:textSize="10sp"
                android:textColor="@color/widget_text_secondary"
                android:layout_marginStart="2dp"
                android:layout_marginBottom="1dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Mini progress bar -->
    <ProgressBar
        android:id="@+id/macro_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="40dp"
        android:layout_height="5dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/widget_macro_fat"
        android:progressBackgroundTint="@color/widget_divider" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:layout_gravity="center"
        android:background="@drawable/widget_hx_placeholder"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Protein -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PROTEIN"
                    android:textColor="@color/widget_hx_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="145 / 180 g"
                    android:textColor="@color/widget_hx_on_surface"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/widget_preview_progress_track">

                    <View
                        android:layout_width="60dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/widget_preview_primary_pill"
                        android:backgroundTint="@color/widget_hx_protein" />

                </FrameLayout>

            </LinearLayout>

            <!-- Carbs -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CARBS"
                    android:textColor="@color/widget_hx_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="210 / 250 g"
                    android:textColor="@color/widget_hx_on_surface"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/widget_preview_progress_track">

                    <View
                        android:layout_width="70dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/widget_preview_primary_pill"
                        android:backgroundTint="@color/widget_hx_carbs" />

                </FrameLayout>

            </LinearLayout>

            <!-- Fat -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FAT"
                    android:textColor="@color/widget_hx_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="55 / 65 g"
                    android:textColor="@color/widget_hx_on_surface"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/widget_preview_progress_track">

                    <View
                        android:layout_width="65dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/widget_preview_primary_pill"
                        android:backgroundTint="@color/widget_hx_fat" />

                </FrameLayout>

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Widget-picker preview for Today's Calories (4x2). Mirrors
     widget_today_calories_medium with sample values baked in. The ring is a
     static shape here; at runtime WidgetRingRenderer paints a real arc bitmap.
     Keep in sync with widget_today_calories_medium.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="8dp"
    android:background="@drawable/widget_card_bg">

    <!-- Top: ring + macro breakdown -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="108dp"
            android:layout_height="match_parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_preview_ring_green"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="642"
                    android:textSize="19sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Remaining"
                    android:textSize="10sp"
                    android:textColor="#8E8E93"
                    android:includeFontPadding="false"
                    android:layout_marginTop="1dp" />

            </LinearLayout>

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <!-- Protein row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/widget_dot"
                    android:backgroundTint="#FF9F0A"
                    android:contentDescription="@null" />

                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:max="100"
                    android:progress="79"
                    android:progressTint="#FF9F0A"
                    android:progressBackgroundTint="#2C2C32" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="142/180"
                    android:textSize="10sp"
                    android:textColor="#8E8E93" />

            </LinearLayout>

            <!-- Carbs row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/widget_dot"
                    android:backgroundTint="#64D2FF"
                    android:contentDescription="@null" />

                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:max="100"
                    android:progress="78"
                    android:progressTint="#64D2FF"
                    android:progressBackgroundTint="#2C2C32" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="186/240"
                    android:textSize="10sp"
                    android:textColor="#8E8E93" />

            </LinearLayout>

            <!-- Fat row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/widget_dot"
                    android:backgroundTint="#BF5AF2"
                    android:contentDescription="@null" />

                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:max="100"
                    android:progress="74"
                    android:progressTint="#BF5AF2"
                    android:progressBackgroundTint="#2C2C32" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="52/70"
                    android:textSize="10sp"
                    android:textColor="#8E8E93" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Horizontal divider above the action row. FrameLayout, not View:
         RemoteViews only inflates @RemoteView classes and plain
         android.view.View is not one of them. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2C2C32"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <!-- Bottom: action buttons row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Search -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="8dp"
                android:background="@drawable/widget_action_btn_bg"
                android:src="@drawable/ic_widget_search"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Search"
                android:textSize="9sp"
                android:textColor="#8E8E93" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="34dp"
            android:background="#2C2C32" />

        <!-- Scan -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="8dp"
                android:background="@drawable/widget_action_btn_bg"
                android:src="@drawable/ic_widget_barcode"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Scan"
                android:textSize="9sp"
                android:textColor="#8E8E93" />

        </LinearLayout>

        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="34dp"
            android:background="#2C2C32" />

        <!-- Photo (highlighted, per mockup) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="8dp"
                android:background="@drawable/widget_action_btn_bg_highlight"
                android:src="@drawable/ic_widget_camera"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Photo"
                android:textSize="9sp"
                android:textColor="#8E8E93" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ic_launcher_background">#091322</color>
    <!-- Workout Bubble popup. Fixed dark palette rather than theme-following:
         the popup floats over arbitrary other apps, so it has to stay legible
         no matter what is behind it. `bubble_accent` mirrors HxColors.primary
         (0xFF0A84FF) so the popup still reads as Herculex. -->
    <color name="bubble_popup_surface">#F21C1C1E</color>
    <color name="bubble_accent">#0A84FF</color>
    <color name="bubble_on_surface">#FFFFFFFF</color>
    <color name="bubble_on_surface_variant">#B3FFFFFF</color>
    <!-- Full-screen dim shown behind the bubble+popup while open, ~35% black.
         Alpha is baked into the color, but the view's own alpha is what's
         actually animated for the fade in/out (see WorkoutBubbleController). -->
    <color name="bubble_scrim">#59000000</color>
    <!-- Home-screen widget placeholder, before the first draw: Classic Blue
         surfaceContainerLowest / outlineVariant at 30 %. -->
    <color name="widget_hx_surface">#F5F9FF</color>
    <color name="widget_hx_outline">#4DCFE0F3</color>
    <color name="widget_hx_primary">#0A84FF</color>
    <color name="widget_hx_on_primary">#FFFFFF</color>
    <color name="widget_hx_on_surface">#0B1526</color>
    <color name="widget_hx_secondary">#64748B</color>
    <color name="widget_hx_surface_variant">#DDE9F7</color>
    <color name="widget_hx_kcal">#E0362C</color>
    <color name="widget_hx_protein">#1F6FD6</color>
    <color name="widget_hx_carbs">#248A3D</color>
    <color name="widget_hx_fat">#D97706</color>
    <color name="widget_hx_success">#1E7A34</color>
    <color name="widget_hx_warning">#B36A00</color>
    <color name="widget_hx_danger">#C7261C</color>
    <color name="widget_hx_recovery">#8036B8</color>
    <color name="widget_hx_fasting">#0083A8</color>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!-- Card surface: the app's navy surfaceContainer fading into a deeper tone,
     with a hairline outline, so widgets read as part of the app's glass cards. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:angle="270"
        android:startColor="#18223A"
        android:endColor="#0E1624" />
    <stroke
        android:width="1dp"
        android:color="#2B374E" />
</shape>

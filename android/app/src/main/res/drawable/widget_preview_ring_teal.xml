<?xml version="1.0" encoding="utf-8"?>
<!-- Static stand-in for the Canvas-drawn ring, used only by widget_preview_*
     layouts. At runtime WidgetRingRenderer supplies a real arc bitmap. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="ring"
    android:innerRadiusRatio="2.5"
    android:thicknessRatio="11"
    android:useLevel="false">
    <solid android:color="#64D2FF" />
</shape>

        <!-- Repaints all widgets after a reboot / app update. Every provider
             uses updatePeriodMillis="0", so Android sends them nothing on its
             own and they would stay blank until the app is next opened. -->
        <receiver
            android:name=".WidgetBootReceiver"
            android:exported="false">
            <intent-filter>
